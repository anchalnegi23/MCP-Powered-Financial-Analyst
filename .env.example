# ─── LLM ──────────────────────────────────────────────────────────────────────
# Required for the LangGraph agent (Phase 7+). Get one at console.anthropic.com
ANTHROPIC_API_KEY=
# Set OPENAI_API_KEY instead and point LLM_MODEL at an OpenAI model (e.g. gpt-4o)
# to use OpenAI. The provider is inferred from the model name.
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-5

# ─── Market / financial data providers ────────────────────────────────────────
# Default provider is yfinance, which needs NO key. Keys below are optional
# alternates used by the service layer when present.
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ─── News provider (Phase 5) ──────────────────────────────────────────────────
# Falls back to yfinance news when unset.
NEWSAPI_API_KEY=

# ─── PostgreSQL (Phase 11) ────────────────────────────────────────────────────
POSTGRES_USER=analyst
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=financial_analyst
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://analyst:change-me-locally@localhost:5432/financial_analyst

# ─── Redis cache (Phase 14) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=900

# ─── Vector store (Phase 12) ──────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma

# ─── MCP servers ──────────────────────────────────────────────────────────────
# Leave these unset for local development: the MCP client then launches each server as
# a stdio subprocess. Docker Compose sets them so the API talks to the five MCP
# containers over HTTP instead. Same code, same protocol, different transport.
# CALCULATOR_MCP_URL=http://calculator-mcp:8001/mcp
# MARKET_MCP_URL=http://market-mcp:8002/mcp
# FINANCIAL_MCP_URL=http://financial-mcp:8003/mcp
# NEWS_MCP_URL=http://news-mcp:8004/mcp
# RESEARCH_MCP_URL=http://research-mcp:8005/mcp

# ─── Ports (host side; change if something already uses them) ─────────────────
API_PORT=8000
UI_PORT=8501
REDIS_PORT=6379

# ─── App ──────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
# Seconds before an external provider call is abandoned.
HTTP_TIMEOUT_SECONDS=15
